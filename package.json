{
  "name": "zyplux-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @zyplux/web dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "vitest run",
    "upgrade": "pnpm run cz upgrade",
    "cz": "node scripts/run-cz.ts"
  },
  "devDependencies": {
    "@zyplux/cz": "catalog:",
    "@zyplux/eslint-config": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-mdx": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "vitest": "catalog:",
    "@mdx-js/rollup": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "@zyplux/mdx": "workspace:*",
    "@zyplux/web": "workspace:*",
    "remark-preset-lint-recommended": "catalog:",
    "unified": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
